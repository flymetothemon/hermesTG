# Railway injects PORT. Keep this aligned with Hermes' dashboard through
# railway-entrypoint.sh; you normally do not need to set PORT manually.
PORT=9119

# Public dashboard authentication. Required because Railway exposes the
# dashboard on a non-loopback interface.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=

# Persistent Hermes state. Attach a Railway Volume at /opt/data.
HERMES_HOME=/opt/data

# Enable the supervised dashboard alongside the gateway.
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
